{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-server",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-c", "import http.server,os,socketserver; port=int(os.environ.get('PORT','8099')); socketserver.TCPServer.allow_reuse_address=True; socketserver.TCPServer(('',port), http.server.SimpleHTTPRequestHandler).serve_forever()"],
      "port": 8099,
      "autoPort": true
    }
  ]
}
